   "spec": {
    "tools": [
     {
      "name": "probe",
      "title": "Probe tool",
      "description": "Looks up a record by its identifier.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "q": {
         "type": "string",
         "description": "Record identifier."
        }
       }
      },
      "annotations": {
       "readOnlyHint": true,
       "openWorldHint": false
      }
