{
 "rule": "directory-conversation-history-input",
 "cases": [
  {
   "name": "conversation-history-turns",
   "spec": {
    "tools": [
     {
      "name": "answer",
      "title": "Answer",
      "description": "Answer a question using the conversation so far.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "question": {
         "type": "string"
        },
        "conversation_history": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "role": {
            "type": "string"
           },
           "content": {
            "type": "string"
           }
          },
          "required": [
           "role",
           "content"
          ]
         }
        }
       }
      },
      "annotations": {
       "readOnlyHint": true,
       "destructiveHint": false,
       "openWorldHint": false
      }
     }
    ]
   },
   "args": [
    "--directory",
    "all"
   ],
   "expect": "present",
   "directories": {
    "claude": "warning",
    "openai": "warning",
    "muse": null
   }
  },
