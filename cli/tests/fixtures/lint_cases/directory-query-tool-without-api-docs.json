  {
   "name": "sql-no-link",
   "spec": {
    "tools": [
     {
      "name": "run_query",
      "title": "Run query",
      "description": "Run a query against the warehouse.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "sql": {
         "type": "string"
        }
       }
      },
      "annotations": {
       "readOnlyHint": false,
       "destructiveHint": true,
       "openWorldHint": false
      }
     }
    ]
   },
   "args": [
    "--directory",
    "all"
   ],
   "expect": "present",
   "directories": {
    "claude": "warning",
    "openai": null,
    "muse": null
   }
  },
