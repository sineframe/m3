      "credentials": [],
      "verification": "manual-ui"
    },
    {
      "id": "first-test-guide-extensions",
      "command": "m3 test -- tests/test_trace.py tests/test_persistence.py tests/test_shipping_evaluation.py tests/test_judge_evidence.py tests/test_shipping_async.py tests/test_mock_shipping.py tests/test_shipping_snapshot.py",
      "expected_exit_code": 0,
      "assertions": ["trace, storage, evaluator, judge evidence, async, mock, and snapshot guide tests pass"],
      "verification": "deterministic"
    },
