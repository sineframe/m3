  "scenarios": [
    {
      "id": "first-test-pass",
      "command": "m3 test -- tests/test_m3_starter.py",
      "expected_exit_code": 0,
      "assertions": ["shipping_quote is discovered", "structured quote is 9.0 USD"],
      "credentials": [],
      "verification": "deterministic"
    },
    {
      "id": "first-test-deliberate-assertion-failure",
      "change": "expect amount 10.0 instead of 9.0",
      "command": "m3 test -- tests/test_m3_starter.py",
      "expected_exit_code": 1,
      "assertions": ["pytest reports the structured-content assertion failure"],
      "credentials": [],
      "verification": "deterministic"
    },
    {
      "id": "first-test-open-viewer",
