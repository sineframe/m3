{
  "$defs": {
    "ConnectionId": {
      "title": "ConnectionId",
      "type": "string"
    },
    "EventDirection": {
      "enum": [
        "client_to_server",
        "server_to_client",
        "sdk_to_harness",
        "harness_to_sdk",
        "internal"
      ],
      "title": "EventDirection",
      "type": "string"
    },
    "EventId": {
      "title": "EventId",
      "type": "string"
    },
    "EventKind": {
      "description": "Closed taxonomy for stable harness-neutral events.",
      "enum": [
        "execution.created",
        "execution.state_changed",
        "execution.finished",
        "session.created",
        "session.state_changed",
        "turn.created",
        "turn.state_changed",
        "process.started",
        "process.exited",
        "transport.connected",
        "transport.disconnected",
        "mcp.initialized",
        "mcp.request",
        "mcp.response",
        "mcp.error",
        "mcp.notification",
        "mcp.progress",
        "mcp.cancellation_requested",
        "mcp.cancellation_completed",
        "agent.message",
        "assistant.content",
        "tool.call_requested",
        "tool.result_received",
        "permission.request",
        "permission.response",
        "sampling.request",
        "sampling.response",
        "elicitation.request",
        "elicitation.response",
        "filesystem.read.request",
        "filesystem.read.response",
        "filesystem.write.request",
        "filesystem.write.response",
        "terminal.create.request",
        "terminal.create.response",
        "terminal.output.request",
        "terminal.output.response",
        "terminal.wait.request",
        "terminal.wait.response",
        "terminal.release.request",
        "terminal.release.response",
        "terminal.kill.request",
        "terminal.kill.response",
        "reasoning",
        "evaluation.recorded",
        "artifact.recorded",
        "workspace.changed",
        "cleanup.started",
        "cleanup.finished",
        "diagnostic",
        "provider.event"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "EventOrigin": {
      "enum": [
        "normalized",
        "wire_observed",
        "harness_reported",
        "derived"
      ],
      "title": "EventOrigin",
      "type": "string"
    },
    "PayloadRef": {
      "additionalProperties": false,
      "properties": {
        "blob_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Blob Id",
          "type": "string"
        },
        "compression": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compression"
        },
        "media_type": {
          "default": "application/json",
          "maxLength": 256,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "blob_id",
        "sha256",
        "size_bytes"
      ],
      "title": "PayloadRef",
      "type": "object"
    },
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "derived_from_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From Sequence"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin"
        },
        "provider_kind": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Kind"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "source"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "ExecutionId": {
      "title": "ExecutionId",
      "type": "string"
    },
    "LifecyclePhase": {
      "enum": [
        "preflight",
        "startup",
        "initialization",
        "idle",
        "turn",
        "mcp_call",
        "cleanup",
        "terminal",
        "unknown"
      ],
      "title": "LifecyclePhase",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "storage_key": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Key"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ReasoningState": {
      "additionalProperties": false,
      "properties": {
        "explicit": {
          "default": false,
          "title": "Explicit",
          "type": "boolean"
        },
        "payload_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visibility": {
          "$ref": "#/$defs/ReasoningVisibility"
        }
      },
      "required": [
        "visibility"
      ],
      "title": "ReasoningState",
      "type": "object"
    },
    "ReasoningVisibility": {
      "enum": [
        "visible",
        "unavailable",
        "encrypted",
        "provider_hidden"
      ],
      "title": "ReasoningVisibility",
      "type": "string"
    },
    "RequestLink": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/EventDirection"
        },
        "jsonrpc_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jsonrpc Id"
        },
        "request_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Sequence"
        }
      },
      "required": [
        "direction"
      ],
      "title": "RequestLink",
      "type": "object"
    },
    "SessionId": {
      "title": "SessionId",
      "type": "string"
    },
    "TurnId": {
      "title": "TurnId",
      "type": "string"
    }
  },
  "$id": "https://mcp-pal.local/schemas/mcp-pal.event.v0.2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connection_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConnectionId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestLink"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "execution_id": {
      "$ref": "#/$defs/ExecutionId"
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "lifecycle_phase": {
      "$ref": "#/$defs/LifecyclePhase",
      "default": "unknown"
    },
    "monotonic_offset_ms": {
      "minimum": 0,
      "title": "Monotonic Offset Ms",
      "type": "number"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/PayloadRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/EventSource"
    },
    "raw_evidence_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasoningState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "const": "mcp_pal.event",
      "default": "mcp_pal.event",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "server_binding": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Server Binding"
    },
    "session_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "execution_id",
    "sequence",
    "kind",
    "monotonic_offset_ms"
  ],
  "title": "Event",
  "type": "object"
}
