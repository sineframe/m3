{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3.local/schemas/m3.harness.v1.schema.json",
  "title": "M3 ACP harness manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "protocol_version", "command"],
  "properties": {
    "schema_version": {"const": "m3.harness.v1"},
    "protocol": {"const": "acp"},
    "protocol_version": {"const": 1},
    "command": {"type": "string", "minLength": 1, "maxLength": 1000},
    "args": {"type": "array", "items": {"type": "string"}},
    "env": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"type": "string", "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"}
    }
  }
}
