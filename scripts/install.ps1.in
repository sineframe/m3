$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$Version = '@MCP_PAL_VERSION@'
$Repository = 'rishhavv/mcp-pal'
$ReleaseTag = "v$Version"
$HasBaseUrl = [bool]$env:MCP_PAL_RELEASE_BASE_URL
$BaseUrl = if ($env:MCP_PAL_RELEASE_BASE_URL) { $env:MCP_PAL_RELEASE_BASE_URL.TrimEnd('/') } else { "https://github.com/$Repository/releases/download/v$Version" }

$CliWheel = "mcp_pal_cli-$Version-py3-none-any.whl"
$SdkWheel = "mcp_pal-$Version-py3-none-any.whl"
$AppWheel = "mcp_pal_app-$Version-py3-none-any.whl"
$WheelNames = @($CliWheel, $SdkWheel, $AppWheel)
$TempDir = Join-Path ([IO.Path]::GetTempPath()) ('mcp-pal-install-' + [Guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $TempDir -Force | Out-Null
Write-Output "Installing MCP Pal CLI $Version"

function Fail([string]$Message) {
    throw "mcp-pal install failed: $Message"
}

function Download([string]$Name, [string]$Destination) {
    if (-not $HasBaseUrl) {
        $Gh = Get-Command gh -ErrorAction SilentlyContinue
        if ($Gh) {
            & $Gh.Source auth status --hostname github.com *> $null
            if ($LASTEXITCODE -eq 0) {
                & $Gh.Source release download $ReleaseTag --repo $Repository --pattern $Name --output $Destination *> $null
                if ($LASTEXITCODE -ne 0) { Fail "could not download $Name with gh; check repository access" }
                if (-not (Test-Path -LiteralPath $Destination -PathType Leaf)) { Fail "gh did not create $Name" }
                return
            }
        }
    }

    try {
        Invoke-WebRequest -UseBasicParsing -Uri "$BaseUrl/$Name" -OutFile $Destination | Out-Null
    } catch {
        Fail "could not download $Name"
    }
}

try {
    Write-Output '[1/4] Downloading release assets'
    foreach ($Name in ($WheelNames + 'SHA256SUMS')) {
        Download $Name (Join-Path $TempDir $Name)
    }

    Write-Output '[2/4] Verifying checksums'
    $records = @{}
    $lines = @(Get-Content -LiteralPath (Join-Path $TempDir 'SHA256SUMS'))
    if ($lines.Count -ne 3) { Fail 'SHA256SUMS must contain exactly three records' }
    foreach ($Line in $lines) {
        if ($Line -notmatch '^([0-9A-Fa-f]{64})  (.+)$') { Fail 'SHA256SUMS contains a malformed record' }
        $Hash = $Matches[1].ToLowerInvariant()
        $Name = $Matches[2]
        if ($Name -notin $WheelNames) { Fail 'SHA256SUMS contains an unexpected filename' }
        if ($records.ContainsKey($Name)) { Fail "SHA256SUMS contains a duplicate record for $Name" }
        $records[$Name] = $Hash
    }
    foreach ($Name in $WheelNames) {
        if (-not $records.ContainsKey($Name)) { Fail "SHA256SUMS is missing $Name" }
        $Actual = (Get-FileHash -Algorithm SHA256 -LiteralPath (Join-Path $TempDir $Name)).Hash.ToLowerInvariant()
        if ($Actual -ne $records[$Name]) { Fail "checksum mismatch for $Name" }
    }

    $UiCheck = 'from importlib import resources; root = resources.files("mcp_pal_cli").joinpath("ui"); assert root.joinpath("index.html").is_file(); assert any(item.is_file() for item in root.joinpath("assets").iterdir())'
    Write-Output '[3/4] Installing into isolated tool storage'
    $Uv = Get-Command uv -ErrorAction SilentlyContinue
    if ($Uv) {
        & $Uv.Source tool install --force (Join-Path $TempDir $CliWheel) --with (Join-Path $TempDir $SdkWheel) --with (Join-Path $TempDir $AppWheel)
        if ($LASTEXITCODE -ne 0) { Fail 'uv tool install failed' }
        $UvBin = (& $Uv.Source tool dir --bin 2>$null).Trim()
        if (-not $UvBin) { Fail 'could not locate the uv tool bin directory' }
        $Command = Join-Path $UvBin 'mcp-pal.exe'
        if (-not (Test-Path -LiteralPath $Command)) { Fail 'uv tool bin directory is missing mcp-pal.exe' }
        Write-Output '[4/4] Verifying command and bundled UI'
        & $Command --help | Out-Null
        if ($LASTEXITCODE -ne 0) { Fail 'installed mcp-pal command failed' }
        $ToolRoot = (& $Uv.Source tool dir 2>$null).Trim()
        $ToolPython = Join-Path (Join-Path $ToolRoot 'mcp-pal-cli') 'Scripts/python.exe'
        if (-not (Test-Path -LiteralPath $ToolPython)) { Fail 'uv tool environment Python is missing' }
        & $ToolPython -c $UiCheck
        if ($LASTEXITCODE -ne 0) { Fail 'packaged UI could not be imported from the CLI wheel' }
        Write-Output 'mcp-pal installed with uv in isolated tool storage.'
        Write-Output "Command: $Command"
        Write-Output 'Next: cd <project>; mcp-pal setup'
    } else {

    $PythonCandidates = @()
    if ($env:MCP_PAL_PYTHON) { $PythonCandidates += $env:MCP_PAL_PYTHON }
    $PythonCandidates += @('py', 'python')
    $Python = $null
    foreach ($Candidate in $PythonCandidates) {
        try {
            if ($Candidate -eq 'py') { & $Candidate -3.10 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' } else { & $Candidate -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' }
            if ($LASTEXITCODE -eq 0) { $Python = $Candidate; break }
        } catch { }
    }
    if (-not $Python) { Fail 'Python 3.10 or newer is required when uv is unavailable' }

    $InstallRoot = if ($env:MCP_PAL_INSTALL_ROOT) { $env:MCP_PAL_INSTALL_ROOT } else { Join-Path $env:LOCALAPPDATA 'mcp-pal' }
    if (Test-Path -LiteralPath $InstallRoot) {
        $Marker = Join-Path $InstallRoot '.mcp-pal-install'
        if (-not (Test-Path -LiteralPath $Marker)) { Fail "refusing to overwrite existing $InstallRoot" }
    }
    $BinDir = if ($env:MCP_PAL_BIN_DIR) { $env:MCP_PAL_BIN_DIR } else { Join-Path $env:LOCALAPPDATA 'mcp-pal-bin' }
    New-Item -ItemType Directory -Path $BinDir -Force | Out-Null
    $CommandPath = Join-Path $BinDir 'mcp-pal.cmd'
    if (Test-Path -LiteralPath $CommandPath) {
        $Existing = Get-Content -Raw -LiteralPath $CommandPath
        if ($Existing -notmatch 'Managed by mcp-pal installer') { Fail "refusing to overwrite existing $CommandPath" }
    }

    $Backup = "$InstallRoot.backup.$([Guid]::NewGuid().ToString('N'))"
    $CommandBackup = "$CommandPath.backup.$([Guid]::NewGuid().ToString('N'))"
    $HadRoot = Test-Path -LiteralPath $InstallRoot
    $HadCommand = Test-Path -LiteralPath $CommandPath
    if ((Test-Path -LiteralPath $Backup) -or (Test-Path -LiteralPath $CommandBackup)) { Fail 'temporary backup path already exists' }
    $RootMoved = $false
    $CreatedNewRoot = $false
    $CreatedCommand = $false
    try {
        if ($HadRoot) {
            Move-Item -LiteralPath $InstallRoot -Destination $Backup
            $RootMoved = $true
        }
        $CreatedNewRoot = $true
        if ($Python -eq 'py') { & $Python -3.10 -m venv $InstallRoot } else { & $Python -m venv $InstallRoot }
        if ($LASTEXITCODE -ne 0) { Fail 'could not create the dedicated virtual environment' }
        $VenvPython = Join-Path $InstallRoot 'Scripts/python.exe'
        & $VenvPython -m pip install --disable-pip-version-check (Join-Path $TempDir $CliWheel) (Join-Path $TempDir $SdkWheel) (Join-Path $TempDir $AppWheel)
        if ($LASTEXITCODE -ne 0) { Fail 'could not install the release wheels in the dedicated virtual environment' }
        & $VenvPython -c $UiCheck
        if ($LASTEXITCODE -ne 0) { Fail 'packaged UI could not be imported from the CLI wheel' }
        Set-Content -NoNewline -LiteralPath (Join-Path $InstallRoot '.mcp-pal-install') -Value $Version

        if ($HadCommand) { Move-Item -LiteralPath $CommandPath -Destination $CommandBackup }
        $Shim = "@echo off`r`nrem Managed by mcp-pal installer`r`n`"$InstallRoot\Scripts\mcp-pal.exe`" %*`r`n"
        $ShimTemp = "$CommandPath.tmp.$([Guid]::NewGuid().ToString('N'))"
        if (Test-Path -LiteralPath $ShimTemp) { Fail 'temporary command path already exists' }
        Set-Content -LiteralPath $ShimTemp -Value $Shim -Encoding ASCII
        Move-Item -Force -LiteralPath $ShimTemp -Destination $CommandPath
        $CreatedCommand = $true
        Write-Output '[4/4] Verifying command and bundled UI'
        & $CommandPath --help | Out-Null
        if ($LASTEXITCODE -ne 0) { Fail 'installed mcp-pal command failed' }
    } catch {
        if ($CreatedNewRoot -and (Test-Path -LiteralPath $InstallRoot)) { Remove-Item -Recurse -Force -LiteralPath $InstallRoot }
        if ($CreatedCommand -and (Test-Path -LiteralPath $CommandPath)) { Remove-Item -Force -LiteralPath $CommandPath }
        if ($RootMoved -and (Test-Path -LiteralPath $Backup)) { Move-Item -LiteralPath $Backup -Destination $InstallRoot }
        if ($HadCommand -and (Test-Path -LiteralPath $CommandBackup)) { Move-Item -LiteralPath $CommandBackup -Destination $CommandPath }
        throw
    }
    if ($HadRoot -and (Test-Path -LiteralPath $Backup)) { Remove-Item -Recurse -Force -LiteralPath $Backup }
    if ($HadCommand -and (Test-Path -LiteralPath $CommandBackup)) { Remove-Item -Force -LiteralPath $CommandBackup }
        Write-Output "mcp-pal installed in $InstallRoot."
        Write-Output "Command: $CommandPath"
        Write-Output 'Next: cd <project>; mcp-pal setup'
        if ($env:PATH -notlike "*$BinDir*") { Write-Output "Add $BinDir to PATH to run mcp-pal." }
    }
} finally {
    if (Test-Path -LiteralPath $TempDir) { Remove-Item -Recurse -Force -LiteralPath $TempDir }
}
